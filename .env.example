# EdgeView Configuration
# ----------------------
# Canonical API-key storage is `config.json` at the repo root (single source of
# truth). Optional overrides, in order of precedence:
#   config.json  >  environment variable (e.g. NVIDIA_API_KEY)  >  .env below
#
# EDGEVIEW_CONFIG: absolute path to an alternate config.json (used by tests and
#   isolated deployments). NEVER point this at the production config in tests.
# EDGEVIEW_CONFIG=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hermes Configuration (replace with real values locally)
HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=your_hermes_api_key_here

# WhatsApp Configuration (replace with real values locally)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_API_URL=http://localhost:3001/api/whatsapp

# Optional Provider-Aware Research Orchestration Keys
SERPER_API_KEY=
FIRECRAWL_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
HUNTER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
LINKUP_API_KEY=

